<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS (Windows hosting) istek boyutu sınırı. IIS varsayılanı ~28,6 MB'tır; video yüklemesi (en fazla 60 MB + kapak) için 100 MB'a çıkarılır.
  Uygulama içi sınırlar endpoint bazında ayrıca uygulanır (UploadImage / UploadVideo). Publish sırasında aspNetCore bölümü otomatik eklenir.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="104857600" />
          <!-- Öğrenci belgeleri (/uploads/documents) IIS düzeyinde de kapalı: adresle erişilemez, yalnızca yönetici API'si okur -->
          <hiddenSegments>
            <add segment="documents" />
          </hiddenSegments>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
