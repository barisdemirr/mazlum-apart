# ── Sunucu (Vercel "Environment Variables") ─────────────────────────────
# Backend adresi (yalnızca sunucuda okunur, tarayıcıya gitmez)
API_URL=https://api.mazlumapart.com

# Backend appsettings "Frontend:ProxySecret" ile AYNI olmalı.
# Vercel'in istediği gerçek istemci IP'sini backend'e güvenle iletmek için kullanılır (hız sınırı).
PROXY_SECRET=

# ── Tarayıcıya açık ────────────────────────────────────────────────────
# Yüklenen görsel/videoların adresi (backend'in açık adresi)
NEXT_PUBLIC_API_URL=https://api.mazlumapart.com

# Web Push (VAPID) açık anahtarı: backend appsettings "Push:PublicKey" ile aynı
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BGnfJ2wNDf4z0tBt0zjiThU_HJTWCZfU02vt1wNP3A8VJ-R39b16t7Zr68uxHm613jriW3u_btWO1ZsTLDfqVv0
